-static char *_notes_container_path(void)
+static char *_notes_container_path(const ane_db *db)
 {
+    /*
+     * Resolve attachments beside the database that was opened. This is
+     * essential for read-only exports from a copied Notes container: --db
+     * selects the copied NoteStore.sqlite, so media must come from that same
+     * container rather than from the current user's live Notes library.
+     */
+    if (db && db->db_path && db->db_path[0] != '\0') {
+        char *path = strdup(db->db_path);
+        if (!path) return NULL;
+
+        char *separator = strrchr(path, '/');
+        if (!separator) {
+            free(path);
+            return strdup(".");
+        }
+
+        if (separator == path) {
+            separator[1] = '\0';
+        } else {
+            *separator = '\0';
+        }
+        return path;
+    }
+
     const char *home = getenv("HOME");
     if (!home) return NULL;
 
